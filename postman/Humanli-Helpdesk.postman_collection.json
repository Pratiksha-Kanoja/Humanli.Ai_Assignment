{
  "info": {
    "_postman_id": "c0e6d2b2-8a0a-4f8d-9c58-6fd4a8b4a3bf",
    "name": "Humanli Helpdesk API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"User\",\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPass123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) { pm.collectionVariables.set('token', json.token); }",
                  "if (json.user?.id) { pm.collectionVariables.set('userId', json.user.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"StrongPass123\"\n}"
            }
          }
        },
        {
          "name": "Me",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Tickets",
      "item": [
        {
          "name": "List My Tickets",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/tickets", "host": ["{{baseUrl}}"], "path": ["api", "tickets"] }
          }
        },
        {
          "name": "Create Ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.ticket?._id) { pm.collectionVariables.set('ticketId', json.ticket._id); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/tickets", "host": ["{{baseUrl}}"], "path": ["api", "tickets"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cannot login\",\n  \"description\": \"I am seeing an error while logging in.\",\n  \"category\": \"Auth\",\n  \"priority\": \"high\"\n}"
            }
          }
        },
        {
          "name": "Get Ticket",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}"]
            }
          }
        },
        {
          "name": "Update Ticket (owner; open only)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated details...\"\n}" }
          }
        },
        {
          "name": "Add Comment",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}", "comments"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"body\": \"Any update on this?\"\n}" }
          }
        },
        {
          "name": "List Comments",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/comments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}", "comments"]
            }
          }
        },
        {
          "name": "List Activity",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}/activity",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}", "activity"]
            }
          }
        },
        {
          "name": "Delete Ticket (owner; open only)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tickets", "{{ticketId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "List Tickets (admin)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/tickets?status=open&limit=20", "host": ["{{baseUrl}}"], "path": ["api", "admin", "tickets"], "query": [{ "key": "status", "value": "open" }, { "key": "limit", "value": "20" }] }
          }
        },
        {
          "name": "Update Ticket (admin)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/admin/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "tickets", "{{ticketId}}"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"resolved\",\n  \"priority\": \"urgent\"\n}" }
          }
        },
        {
          "name": "Ticket Details (admin)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/admin/tickets/{{ticketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "tickets", "{{ticketId}}"]
            }
          }
        },
        {
          "name": "Global Activity (admin)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/activity?limit=50", "host": ["{{baseUrl}}"], "path": ["api", "admin", "activity"], "query": [{ "key": "limit", "value": "50" }] }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" },
    { "key": "ticketId", "value": "" },
    { "key": "userId", "value": "" }
  ]
}

